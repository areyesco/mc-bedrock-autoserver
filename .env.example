TZ=America/Mexico_City
MC_HOST_PORT=19132
MC_SERVER_NAME="Minecraft Familiar"
MC_LEVEL_NAME="Mundo Familiar"
MC_GAMEMODE=survival
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=10
MC_ALLOW_CHEATS=false
MC_ENABLE_LAN_VISIBILITY=true
MC_IDLE_TIMEOUT=PT30M
MC_STARTUP_GRACE=PT3M
MC_PING_TIMEOUT=PT1S
MC_STOP_TIMEOUT=PT45S
MC_MONITOR_INTERVAL_MS=30000
MC_PUBLIC_HOST=
CONTROL_HOST_PORT=8080

# Image pins/overrides. BDS remains on a stable image line and downloads the
# latest non-preview Bedrock server package at startup via BDS_VERSION=LATEST.
DOCKER_API_PROXY_IMAGE=haproxy:3.2.22-alpine
LAZYTAINER_IMAGE=ghcr.io/vmorganp/lazytainer:master
BDS_IMAGE=itzg/minecraft-bedrock-server:stable
BDS_VERSION=LATEST
OPENAI_TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.11

# MCP is optional. Generate with: openssl rand -hex 32
MCP_SHARED_TOKEN=
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
TUNNEL_LOG_LEVEL=info
